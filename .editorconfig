# SPDX-License-Identifier: BSD-3-Clause
# Editor defaults. CI enforces the whitespace part with
# tests/check_whitespace.sh: LF, a final newline, no trailing blanks,
# spaces rather than tabs (Makefiles excepted). Code formatting itself
# is left to review; there is no clang-format configuration.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
