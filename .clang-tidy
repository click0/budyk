# SPDX-License-Identifier: BSD-3-Clause
# clang-tidy settings used by CI (.github/workflows/linux-build.yml).
# Bug-finding, performance and portability checks, plus two CERT rules
# (unchecked string-to-number conversions, shell commands); style is
# left to review. Disabled:
#   easily-swappable-parameters   flags most multi-int signatures
#   narrowing-conversions,
#   implicit-widening-of-mult...  sizes/counters are converted on purpose
#                                 throughout the codecs and collectors
#   assignment-in-if-condition    `if ((v = f()) != nullptr)` is the
#                                 config parser's idiom
#   DeprecatedOrUnsafeBufferHandling
#                                 asks for C11 Annex K (fscanf_s, ...),
#                                 which neither glibc nor FreeBSD libc has
#   performance-enum-size         wants uint8_t-based enums; the few
#                                 small enums here are not stored in bulk
# src/collector/.clang-tidy turns cert-err34-c off for the /proc and
# sysctl parsers.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  cert-err34-c,
  cert-env33-c,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-assignment-in-if-condition,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -performance-enum-size
WarningsAsErrors: '*'
HeaderFilterRegex: 'src/.*'
